   "fieldtype": "Select",
   "label": "Environment",
   "options": "sandbox\nproduction",
   "default": "sandbox",
   "reqd": 1,
   "description": "sandbox → abhasbx.abdm.gov.in | production → abha.abdm.gov.in"
  },
  {
   "fieldname": "column_break_env",
   "fieldtype": "Column Break"
  },
