   "fieldname": "abha_base_url",
   "fieldtype": "Data",
   "label": "ABHA Base URL",
   "default": "https://abhasbx.abdm.gov.in/abha/api",
   "reqd": 1,
   "description": "SBX: abhasbx.abdm.gov.in/abha/api | PROD: abha.abdm.gov.in/abha/api"
  },
  {
   "fieldname": "phr_base_url",
   "fieldtype": "Data",
   "label": "PHR Base URL",
   "default": "https://abhasbx.abdm.gov.in/abha/api",
   "description": "SBX: https://abhasbx.abdm.gov.in/abha/api | PROD: https://abha.abdm.gov.in/abha/api — used for ABHA address verification (SOP §14). Falls back to ABHA Base URL when blank."
  },
  {
   "fieldname": "section_break_credentials",
   "fieldtype": "Section Break",
   "label": "ABDM Credentials"
  },
  {
   "fieldname": "client_id",
   "fieldtype": "Data",
   "label": "Client ID",
   "reqd": 1,
   "description": "ABDM client_id (e.g. SBXID_xxxxxx for sandbox)"
  },
  {
   "fieldname": "client_secret",
   "fieldtype": "Password",
   "label": "Client Secret",
   "reqd": 1,
   "description": "ABDM client_secret — stored encrypted, never logged"
  },
  {
   "fieldname": "section_break_urls",
   "fieldtype": "Section Break",
   "label": "Integration URLs"
  },
  {
   "fieldname": "wrapper_base_url",
   "fieldtype": "Data",
   "label": "Wrapper Base URL",
   "default": "http://localhost:8082",
   "description": "NHA ABDM wrapper — localhost:8082 for M2/M3 gateway flows"
  },
  {
   "fieldname": "fhir_base_url",
   "fieldtype": "Data",
   "label": "FHIR Base URL",
   "default": "https://nrces.in/ndhm/fhir/R4",
   "description": "FHIR R4 profile base — used for all Bundle resource profile references"
  },
  {
   "fieldname": "section_break_security",
   "fieldtype": "Section Break",
   "label": "Security Settings"
  },
  {
   "fieldname": "abdm_gateway_ip_allowlist",
   "fieldtype": "Code",
   "options": "JSON",
   "label": "ABDM Gateway IP Allowlist",
   "description": "JSON array of allowed ABDM gateway IPs for inbound callbacks. RFC 1918 + 169.254.x are always blocked regardless.",
   "default": "[]"
  },
  {
   "fieldname": "callback_secret",
   "fieldtype": "Password",
   "label": "Callback HMAC Secret",
   "description": "Optional: HMAC-SHA256 secret to validate X-HIP-Signature on inbound ABDM callbacks. Leave empty to skip signature verification (sandbox/dev)."
  },
  {
   "fieldname": "rsa_public_key_cache",
